---
import TagList from './TagList.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  showTags?: boolean;
}

const { post, showTags = false } = Astro.props;
const { title, description, pubDate, tags } = post.data;

// Fall back to first ~180 chars of body if no description
const preview = description || post.body
  .replace(/^---[\s\S]*?---/, '')      // strip frontmatter if any
  .replace(/#{1,6}\s+.+/g, '')         // strip headings
  .replace(/[*_`[\]]/g, '')            // strip markdown syntax
  .trim()
  .slice(0, 180)
  .trimEnd() + '…';

const date = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const isoDate = pubDate.toISOString();
---

<li class="post-list__item">
  <a href={`/blog/${post.slug}`} class="post-list__link" tabindex="-1" aria-hidden="true"></a>
  <h2 class="post-list__title">
    <a href={`/blog/${post.slug}`}>{title}</a>
  </h2>
  <div class="post-list__footer">
    {tags.length > 0 ? <TagList tags={tags} /> : <span />}
    <time class="post-list__date" datetime={isoDate}>{date}</time>
  </div>
  <p class="post-list__desc">{preview}</p>
</li>
