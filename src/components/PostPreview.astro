---
import TagList from './TagList.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  showTags?: boolean;
}

const { post, showTags = false } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const date = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const isoDate = pubDate.toISOString();
---

<li class="post-list__item">
  <div class="post-list__meta">
    <time class="post-list__date" datetime={isoDate}>{date}</time>
    <h2 class="post-list__title">
      <a href={`/blog/${post.slug}`}>{title}</a>
    </h2>
  </div>
  {description && <p class="post-list__desc">{description}</p>}
  {showTags && tags.length > 0 && <TagList tags={tags} />}
</li>
