---
/**
 * Giscus comments — powered by GitHub Discussions.
 *
 * Setup steps:
 *   1. Enable Discussions on your GitHub repo.
 *   2. Go to https://giscus.app and configure your repo.
 *   3. Replace the placeholder values below with your actual IDs.
 *
 * Required:
 *   - data-repo:        "owner/repo"
 *   - data-repo-id:     found at giscus.app
 *   - data-category-id: found at giscus.app
 */

const REPO         = "bassamadnan/bassamadnan.github.io";
const REPO_ID      = "R_kgDOSBv-XQ";
const CATEGORY     = "Announcements";
const CATEGORY_ID  = "DIC_kwDOSBv-Xc4C6zil";
---

<section class="giscus-container" aria-label="Comments">
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={REPO}
    data-repo-id={REPO_ID}
    data-category={CATEGORY}
    data-category-id={CATEGORY_ID}
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="noborder_light"
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</section>
